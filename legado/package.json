{
  "name": "salgueiro-gestao",
  "productName": "Salgueiro Gestão",
  "version": "1.0.4",
  "description": "Sistema de gestao completo para a Boutique do Salgueiro",
  "main": "main.js",
  "author": "ML Lopes Design <mlopesdesign@gmail.com>",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/smoke.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "sql.js": "^1.14.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "br.com.mllopes.salgueirogestao",
    "productName": "Salgueiro Gestão",
    "copyright": "2026 ML Lopes Design",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "SalgueiroGestao-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "Salgueiro Gestao",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://ATUALIZE-ESTA-URL.com.br/updates/salgueiro/"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "app/**/*"
    ],
    "asar": false
  }
}
